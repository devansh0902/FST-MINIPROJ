# ---- SERVER-ONLY secrets (never prefix with NEXT_PUBLIC_) : Exp 13 ----
# Exp 14: pooled connection (Supabase pgbouncer :6543 / Neon pooled host) used by the app
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
# Direct connection used only for migrations
DIRECT_URL="postgresql://user:pass@host:5432/postgres"
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/shopsphere"

BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- PUBLIC value (safe to expose to the browser) ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
